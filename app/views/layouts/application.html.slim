doctype html
html
  head
    = stylesheet_link_tag :app, 'data-turbo-track': 'reload'
    = javascript_include_tag 'application', 'data-turbo-track': 'reload', type: 'module'
    - if defined?(Sentry) && Sentry.respond_to?(:get_trace_propagation_meta)
      - trace_meta = Sentry.get_trace_propagation_meta
      - if trace_meta.present?
        trace_meta.html_safe
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    = csrf_meta_tags
    = csp_meta_tag
  body.d-flex.flex-column.h-100
    .container.mb-2
      .d-flex.flex-wrap.align-items-center.py-2.border-bottom
        .navbar.navbar-expand-md.navbar-light.me-auto
          = link_to t('.board'), root_path, class: 'navbar-brand me-md-4'

          .collapse.navbar-collapse#navbarToggler
            ul.nav.nav-pills.flex-grow-1.navbar-nav.me-auto
              li.nav-item.me-2
                = link_to t('.main'), root_path, class: 'nav-link text-dark'
              - if current_user
                li.nav-item.me-2
                  = link_to t('.my_bulletins'), profile_path, class: 'nav-link text-dark'
                li.nav-item.me-2
                  = link_to t('.add'), new_bulletin_path, class: 'nav-link text-dark'
        ul.nav.nav-pills
          - if current_user&.admin?
            li.nav-item.me-2.ms-auto
              = link_to t('.admin_panel'), admin_root_path, class: 'nav-link text-dark'
          li.nav-item.me-2
            - if current_user
              = button_to "#{t('.logout')}", logout_path, method: :delete, class: "btn btn-danger"
            - else
              = button_to auth_request_path(provider: :github), method: :post, data: { turbo: false }, class: "nav-link text-dark" do
                span.bi.bi-github.me-2
                = t('.sign_in')
  = render 'shared/flash'
  - if content_for?(:content)
    = yield :content
  - else
    = yield
  footer.footer.mt-auto.py-3.bg-light
      .container
        span.text-muted © #{Time.current.year} #{t('.board')}. #{t('.all_rights')}
