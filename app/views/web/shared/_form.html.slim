= simple_form_for @bulletin, html: { multipart: true } do |f|
  .mb-3 = f.input :title, input_html: { class: "form-control" }, wrapper_html: { class: 'form-group mb-3' }
  .mb-3 = f.input :description, input_html: { class: "form-control" }, wrapper_html: { class: 'form-group mb-3' }
  .mb-3 = f.association :category,
    collection: Category.all,
    label_method: ->(category) { t("categories.#{category.name.downcase}") },
    input_html: { class: 'form-control' },
    wrapper_html: { class: 'form-group mb-3' }
  - if @bulletin.image.attached?
    = image_tag @bulletin.image.variant(resize_to_limit: [200, 100]), class: 'img-thumbnail mb-2'
  .mb-3 = f.input :image, as: :file, required: true, input_html: { class: "form-control" }
  .mb-3 = f.button :submit, class: "btn btn-primary mt-3"
