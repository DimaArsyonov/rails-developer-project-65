= simple_form_for bulletin, html: { multipart: true } do |f|
  .mb-3 = f.input :title
  .mb-3 = f.input :description
  .mb-3 = f.association :category
  - if bulletin.image.attached?
    = image_tag bulletin.image.variant(resize_to_limit: [200, 100])
  .mb-3 = f.input :image, as: :file
  .mb-3 = f.button :submit, class: "btn btn-primary mt-3"
